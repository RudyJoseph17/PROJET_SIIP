@model List<ProjetValide>
@{
    ViewData["Title"] = "Banque de projets";
    ViewData["Subtitle"] = "Projets validés : fiche d'identification, préfaisabilité, faisabilité et études de projet approuvées par le MPCE";
}
<div class="card shadow mb-4">
    <div class="card-header py-3"><i class="fas fa-award mr-1"></i> Projets validés <span class="badge badge-success ml-1">@Model.Count</span></div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">Aucun projet validé pour le moment. Un projet apparaît ici dès que ses études de projet sont approuvées par le MPCE.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover datatable" data-page-length="25" data-order='[[4,"desc"]]'>
                    <thead><tr><th>Code</th><th>Projet</th><th>Ministère / Institution</th><th>Localisation</th><th>Validé le</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr data-href="@Url.Action("Details", new { id = p.IdFiche })">
                                <td class="text-nowrap">@p.CodeFiche</td>
                                <td><a asp-action="Details" asp-route-id="@p.IdFiche" class="font-weight-bold">@p.TitreProjet</a></td>
                                <td>@p.MinistereInstitution</td>
                                <td>@p.Departement@(string.IsNullOrWhiteSpace(p.Commune) ? "" : " — " + p.Commune)</td>
                                <td data-order="@p.DateValidationProjet.ToString("s")">@p.DateValidationProjet.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
