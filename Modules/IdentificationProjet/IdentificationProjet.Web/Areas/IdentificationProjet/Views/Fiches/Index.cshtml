@model ListeFichesViewModel
@{
    ViewData["Title"] = "Identification de projet";
    ViewData["Subtitle"] = "Fiches d'identification de l'idée de projet (Manuel de procédures, Annexe 3)";
}

@section PageActions {
    <form asp-action="Creer" method="post" class="d-inline">
        <button type="submit" class="btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-lightbulb fa-sm mr-1"></i> Nouvelle idée de projet
        </button>
    </form>
}

@if (Model.EstExaminateur)
{
    <div class="card shadow mb-4 border-left-warning">
        <div class="card-header py-3">
            <i class="fas fa-clipboard-check mr-1"></i> Fiches à examiner
            <span class="badge badge-warning ml-1">@Model.AExaminer.Count</span>
        </div>
        <div class="card-body">
            @if (Model.AExaminer.Count == 0)
            {
                <p class="text-muted mb-0">Aucune fiche en attente de votre examen.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover datatable" data-page-length="10" data-order='[[4,"asc"]]'>
                        <thead>
                            <tr><th>Code</th><th>Titre proposé</th><th>Promoteur</th><th>Statut</th><th>Soumise le</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.AExaminer)
                            {
                                <tr>
                                    <td class="text-nowrap">@f.CodeFiche</td>
                                    <td>@(f.TitreProjet ?? f.MeilleureIdee)</td>
                                    <td>@f.PromoteurNom<div class="small text-muted">@f.NomOrganisation</div></td>
                                    <td><partial name="_StatutBadge" model="f.Statut" /></td>
                                    <td data-order="@f.DateSoumission?.ToString("s")">@f.DateSoumission?.ToString("dd/MM/yyyy")</td>
                                    <td class="text-right text-nowrap">
                                        <a asp-action="Details" asp-route-id="@f.IdFiche" class="btn btn-sm btn-warning">
                                            <i class="fas fa-search fa-sm"></i> Examiner
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3"><i class="fas fa-lightbulb mr-1"></i> Mes idées de projet</div>
    <div class="card-body">
        @if (Model.MesFiches.Count == 0)
        {
            <div class="text-center py-4">
                <i class="fas fa-lightbulb fa-3x text-gray-300 mb-3"></i>
                <p class="mb-1">Vous n'avez encore aucune idée de projet.</p>
                <p class="small text-muted">Une fiche se remplit en 5 étapes : introduction, importance du problème,
                    idées possibles, choix de la meilleure idée et conclusion. Elle est ensuite examinée par l'UEP puis la DIP.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover datatable" data-page-length="25" data-order='[[4,"desc"]]'>
                    <thead>
                        <tr><th>Code</th><th>Titre proposé / problème</th><th>Statut</th><th style="min-width:9rem">Progression</th><th>Modifiée le</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.MesFiches)
                        {
                            var resume = f.TitreProjet
                                ?? (string.IsNullOrWhiteSpace(f.DescriptionProbleme) ? null
                                    : f.DescriptionProbleme.Length > 90 ? f.DescriptionProbleme[..90] + "…" : f.DescriptionProbleme);
                            <tr>
                                <td class="text-nowrap">@f.CodeFiche</td>
                                <td>
                                    @if (resume is null) { <em class="text-muted">À compléter</em> } else { @resume }
                                    @if (f.TitreProjet is null && f.MeilleureIdee is not null)
                                    {
                                        <div class="small text-muted">Meilleure idée : @f.MeilleureIdee</div>
                                    }
                                </td>
                                <td><partial name="_StatutBadge" model="f.Statut" /></td>
                                <td data-order="@f.Progression">
                                    <div class="d-flex align-items-center">
                                        <div class="progress flex-grow-1 mr-2" style="height:.5rem">
                                            <div class="progress-bar @(f.Progression >= 100 ? "bg-success" : "bg-info")" style="width:@(f.Progression)%"></div>
                                        </div>
                                        <span class="small">@f.Progression&nbsp;%</span>
                                    </div>
                                </td>
                                <td data-order="@f.DateModification?.ToString("s")">@f.DateModification?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-right text-nowrap">
                                    @if (f.EstModifiable)
                                    {
                                        <a asp-action="Edit" asp-route-id="@f.IdFiche" class="btn btn-sm btn-primary" title="Continuer la saisie">
                                            <i class="fas fa-edit fa-sm"></i> Continuer
                                        </a>
                                    }
                                    <a asp-action="Details" asp-route-id="@f.IdFiche" class="btn btn-sm btn-outline-secondary" title="Suivi de la fiche">
                                        <i class="fas fa-eye fa-sm"></i> Suivi
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
