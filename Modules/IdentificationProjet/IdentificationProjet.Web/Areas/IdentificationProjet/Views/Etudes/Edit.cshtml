@model EtudeEditViewModel
@{
    var e = Model.Etude!;
    ViewData["Title"] = $"{PhaseProjet.Libelle(e.Phase)} — {e.CodeFiche}";
    ViewData["Subtitle"] = e.TitreProjet;
    ViewData["SupprimerDocuments"] = true;
    var places = LimitesDocumentsEtude.NombreMax - e.NbDocuments;
}
@section PageActions {
    <a asp-action="Details" asp-route-id="@e.IdEtude" class="btn btn-sm btn-outline-secondary shadow-sm"><i class="fas fa-eye fa-sm mr-1"></i> Aperçu et suivi</a>
}

<form asp-action="Edit" asp-route-id="@e.IdEtude" method="post" enctype="multipart/form-data" style="max-width:60rem">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3">Note de présentation</div>
        <div class="card-body">
            <p class="small text-muted">Résumez l'étude jointe : principales conclusions, option retenue, coûts et recommandations.</p>
            <textarea asp-for="Description" class="form-control" rows="6" aria-label="Note de présentation"></textarea>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between">
            <span>Pièces jointes</span><span class="small text-muted">@e.NbDocuments / @LimitesDocumentsEtude.NombreMax</span>
        </div>
        <div class="card-body">
            <partial name="_DocumentsEtude" model="e" />
            @if (places > 0)
            {
                <div class="form-row align-items-end mt-3">
                    <div class="form-group col-md-6">
                        <label for="NouveauxDocuments">Ajouter des documents <span class="small text-muted">(@places au plus, 20 Mo chacun)</span></label>
                        <input type="file" id="NouveauxDocuments" name="NouveauxDocuments" class="form-control-file" multiple accept="@LimitesAnnexes.Accept" />
                    </div>
                    <div class="form-group col-md-6">
                        <label asp-for="DescriptionDocuments"></label>
                        <input asp-for="DescriptionDocuments" class="form-control" placeholder="Ex. : Rapport d'étude, annexes financières" />
                    </div>
                </div>
                <p class="small text-muted mb-0">Les documents sont ajoutés lors de l'enregistrement. Au moins un document est exigé pour soumettre.</p>
            }
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center">
            <span class="small text-muted mb-2 mb-md-0">Après soumission : examen par l'UEP, puis avis du MPCE.</span>
            <div>
                <button type="submit" name="commande" value="enregistrer" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Enregistrer</button>
                <button type="submit" name="commande" value="soumettre" class="btn btn-success"
                        onclick="return confirm('Enregistrer et soumettre l\'étude ? Elle ne sera plus modifiable sauf demande de correction.');">
                    <i class="fas fa-paper-plane mr-1"></i> Enregistrer et soumettre
                </button>
            </div>
        </div>
    </div>
</form>
