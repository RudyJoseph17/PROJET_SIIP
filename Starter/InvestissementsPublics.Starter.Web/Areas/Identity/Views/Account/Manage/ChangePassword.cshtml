@page
@model InvestissementsPublics.Starter.Web.Models.ChangePasswordModel
@{
    ViewData["Title"] = "Changer le mot de passe";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="row">
    <div class="col-md-6">

        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Input.OldPassword" class="form-label">Mot de passe actuel</label>
                <input asp-for="Input.OldPassword" class="form-control" type="password" />
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.NewPassword" class="form-label">Nouveau mot de passe</label>
                <input asp-for="Input.NewPassword" class="form-control" type="password" />
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label">Confirmer le mot de passe</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" type="password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Changer le mot de passe
            </button>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}