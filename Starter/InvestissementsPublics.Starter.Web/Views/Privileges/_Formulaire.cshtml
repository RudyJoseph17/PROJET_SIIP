@model PrivilegeFormViewModel
@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
}
<div class="form-group">
    <label asp-for="Nom"></label> <span class="text-danger">*</span>
    <input asp-for="Nom" class="form-control" placeholder="Ex. : BanqueProjet.Projet.Create" />
    <small class="form-text text-muted">Convention : Module.Objet.Action</small>
    <span asp-validation-for="Nom" class="text-danger small champ-erreur"></span>
</div>
<div class="form-group">
    <label asp-for="Description"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger small champ-erreur"></span>
</div>
