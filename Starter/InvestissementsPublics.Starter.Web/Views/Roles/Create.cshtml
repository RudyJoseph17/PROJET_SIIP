@model RoleFormViewModel
@{
    ViewData["Title"] = "Nouveau rôle";
    ViewData["Subtitle"] = "Sécurité — Rôles";
}
<partial name="Securite/_Onglets" />
<div class="card shadow mb-4" style="max-width:60rem">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <partial name="_Formulaire" model="Model" />
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Créer le rôle</button>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
